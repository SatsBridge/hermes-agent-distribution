+    assert cold._fast_until == started + 60
+    assert fast_mode.effective_request_overrides(cold)["service_tier"] == "priority"
+    fast_mode.begin_turn(
+        cold,
+        conversation_history=[{"role": "user", "content": "prior"}],
+        started_at=started,
+    )
